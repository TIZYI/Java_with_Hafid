package newPackage;
import java.util.Scanner;
public class Main {

	public static void main(String[] args) {
		
		Scanner scanner=new Scanner(System.in);
		
		// exemple for using ternary operator: temperature converter F and C
		
		double temp;
		double newtemp;
		String unit;
		
		System.out.print("Entre the temperature ");
		temp=scanner.nextDouble();
		System.out.print("Convertir to Celcieus or Fahrenheit ? (C or F): ");
		unit=scanner.next().toUpperCase();
		newtemp=(unit=="C")? (temp-32)*5/9 : (temp*5/9)+32;
		System.out.printf("Temperature = %f◦%s ",newtemp, unit);
		
		scanner.close();
}

}
