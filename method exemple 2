		b=scanner.nextDouble();
		Add=addition(a,b);
		System.out.printf("la somme est %.1f\n",Add);
		Add=square(a);
		System.out.printf("le carre de %.1f est %.1f\n",a,Add);
		Add=cube(a);
		System.out.printf("le cube de %.1f est %.1f\n",a,Add);
}
	static double addition(double a , double b) {
		double s=a+b;
		return s;
	}
	static double square(double a ) {
		double s=a*a;
		return s;
	}
	static double cube(double a) {
		double s=a*a*a;
		return s;
	}

}
